<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextAppearanceSearchHint">
        <item name="android:textSize">@dimen/search_hint_size</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textFontWeight">400</item>
    </style>

    <style name="SearchEditText">

        <!-- Фон -->
        <item name="android:background">@drawable/bg_search</item>
        <!-- Иконка поиска внутри -->
        <item name="android:drawableStart">@drawable/search_icon</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableTint">?attr/search_text_color</item>

        <!-- Текст -->
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorHint">?attr/search_text_color</item>

        <item name="android:backgroundTint">@null</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textFontWeight">400</item>
        <item name="hintTextAppearance">@style/TextAppearanceSearchHint</item>
        <!--  Цвет курсора -->
        <item name="android:textCursorDrawable">@drawable/cursor</item>
        <item name="android:paddingEnd">36dp</item>
    </style>

    <style name="SongRow">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SongRow.SongName">
        <item name="android:textColor">?attr/search_list_track_name_color</item>
    </style>

    <style name="SongRow.TextSize12">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="SongRow.TextSize12.TextStyle">
        <item name="android:textColor">?attr/search_list_artist_name_color</item>
    </style>

    <style name="Song.Row.ArtistName" parent="SongRow.TextSize12.TextStyle" />

    <style name="Song.Row.TrackTime" parent="SongRow.TextSize12.TextStyle">
        <item name="android:ellipsize">none</item>
    </style>

</resources>