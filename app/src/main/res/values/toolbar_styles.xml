    <style name="ToolbarPlaylist"  parent="Widget.MaterialComponents.Toolbar">
        <item name="titleTextAppearance">@style/TitleTextAppearance</item>
        <item name="titleTextColor">@color/black_2</item>
        <item name="navigationIconTint">@color/black_2</item>
    </style>
