<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TitleTextAppearance">
        <item name="android:textFontWeight">500</item>
        <item name="fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">22sp</item>
    </style>
    <style name="ToolbarMainText" parent="Widget.MaterialComponents.Toolbar">
        <item name="titleTextAppearance">@style/TitleTextAppearance</item>
        <item name="titleTextColor">?attr/title_text_color</item>
