<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MainButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:textSize">@dimen/main_text_size</item>
        <item name="iconTint">@color/black</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textAllCaps">false</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/activity_main_icon_padding</item>
    </style>
    <style name="MainButton.Search" >
        <item name="icon">@drawable/search</item>
    </style>
    <style name="MainButton.Media"  >
        <item name="icon">@drawable/media</item>
    </style>
    <style name="MainButton.Settings" >
        <item name="icon">@drawable/settings</item>
    </style>
    <style name="TabTextAppearance"  parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">500</item>
    </style>
    <style name="TextAppearanceSettings" >
        <item name="android:textSize">@dimen/settings_text_size</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">400</item>
    </style>
    <style name="SettingMenuItem">
        <item name="android:paddingVertical">@dimen/setting_padding_vertical</item>
        <item name="android:textColor">?attr/menu_text_color</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textAppearance">@style/TextAppearanceSettings</item>
    </style>
</resources>

