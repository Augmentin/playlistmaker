<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/search_view"
    tools:context=".presentation.search.SearchActivity"
    >
    <com.google.android.material.appbar.MaterialToolbar
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@drawable/arrow_back"
        style="@style/ToolbarMainText"
        android:id="@+id/back_toolbar"
        app:title="@string/search"
        />
    <FrameLayout
        android:layout_margin="@dimen/search_margin_size"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <EditText
            android:imeOptions="actionDone"
            android:singleLine="true"
            android:id="@+id/inputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/search"
            android:inputType="text"
            android:maxLines="1"
            style="@style/SearchEditText"
            android:layout_gravity="start|center_vertical"
            />
        <ImageView
            android:visibility="gone"
            android:id="@+id/clearIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            android:layout_gravity="end|center_vertical"
            android:src="@drawable/close_icon"
           />
    </FrameLayout>
    <FrameLayout android:layout_width="match_parent"
        android:layout_height="match_parent"
        >
        <androidx.recyclerview.widget.RecyclerView
            android:layout_margin="@dimen/search_margin_size"
            android:id="@+id/songItems"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        <LinearLayout
            android:layout_marginTop="100dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            >
            <ProgressBar android:id="@+id/progressBar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/blue"
                android:visibility="gone"/>
            <ImageView android:id="@+id/fail_img"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:scaleType="centerCrop"
                android:layout_gravity="center"
                android:visibility="gone"
                tools:visibility="visible"
                tools:srcCompat="@drawable/not_found"
                />
            <TextView
                android:layout_marginTop="@dimen/placeholder_margin_top_elements"
                android:id="@+id/placeholderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textAlignment="center"
                style="@style/SearchErrorPlaceholder"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="@string/connect_problem_title"
                />
            <TextView
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="@dimen/placeholder_margin_top_elements"
                android:id="@+id/placeholderMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textAlignment="center"
                style="@style/SearchErrorPlaceholder"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="@string/connect_problem_message"
                />
            <Button android:id="@+id/refresh"
                android:layout_marginTop="@dimen/placeholder_margin_top_elements"
                style="@style/SearchErrorButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/refresh"
                android:visibility="gone"
                tools:visibility="visible"
                />
        </LinearLayout>
        <LinearLayout
            android:layout_marginTop="30dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible"
            android:id="@+id/searchHistoryGroup"
            >
            <TextView
                android:id="@+id/searchHistoryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textAlignment="center"
                style="@style/SearchErrorPlaceholder"
                android:text="@string/search_history_title"
                />
            <androidx.recyclerview.widget.RecyclerView
                android:layout_margin="@dimen/search_margin_size"
                android:id="@+id/historySongItems"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
            <Button android:id="@+id/historyRefresh"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                style="@style/SearchErrorButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/historyRefresh"
                tools:visibility="visible"
                />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>