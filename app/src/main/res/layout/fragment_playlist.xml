<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_grey"
    android:id="@+id/playlist"
    tools:context=".playlist.ui.fragment.PlaylistFragment"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.appbar.MaterialToolbar
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:navigationIcon="@drawable/arrow_back"
            style="@style/ToolbarPlaylist"
            android:id="@+id/back_toolbar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/left_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.065" />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/right_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.935" />

        <ImageView
            android:id="@+id/image"
            android:layout_width="312dp"
            android:layout_height="312dp"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toStartOf="@id/right_guideline"
            app:layout_constraintStart_toStartOf="@id/left_guideline"
            app:layout_constraintTop_toBottomOf="@id/back_toolbar" />

        <TextView
            android:id="@+id/playlistName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/ys_display_bold"
            android:textColor="@color/black_2"
            android:textSize="24sp"
            app:layout_constraintStart_toStartOf="@id/left_guideline"
            app:layout_constraintTop_toBottomOf="@id/image"
            tools:text="The Beatles" />

        <TextView
            android:id="@+id/playlistDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/ys_display_regular"
            android:textColor="@color/black_2"
            android:textSize="18sp"

            app:layout_constraintStart_toStartOf="@id/left_guideline"
            app:layout_constraintTop_toBottomOf="@id/playlistName"
            tools:text="2022" />

        <TextView
            android:id="@+id/totalTracksTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:autoSizeTextType="uniform"
            android:fontFamily="@font/ys_display_regular"
            android:textColor="@color/black_2"
            android:textSize="18sp"
            android:layout_marginTop="10dp"
            app:layout_constraintStart_toStartOf="@id/left_guideline"
            app:layout_constraintTop_toBottomOf="@id/playlistDescription"
            tools:text="300 минут" />
        <ImageView
            android:id="@+id/ic"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic"
            app:tint="@color/black_2"
            app:layout_constraintStart_toEndOf="@id/totalTracksTime"
            app:layout_constraintBottom_toBottomOf="@id/totalTracksTime"
            />
        <TextView
            android:id="@+id/trackCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:autoSizeTextType="uniform"
            android:fontFamily="@font/ys_display_regular"
            android:textColor="@color/black_2"
            android:textSize="18sp"
            app:layout_constraintStart_toEndOf="@id/ic"
            app:layout_constraintBottom_toBottomOf="@id/ic"
            tools:text="98 треков" />
        <ImageView
            android:id="@+id/bt_share"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/sharing"
            app:tint="@color/black_2"
            app:layout_constraintStart_toStartOf="@id/left_guideline"
            app:layout_constraintTop_toBottomOf="@id/totalTracksTime"
            />
        <ImageView
            android:id="@+id/more"
            android:layout_marginStart="18dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/more"
            app:tint="@color/black_2"
            app:layout_constraintStart_toEndOf="@id/bt_share"
            app:layout_constraintTop_toBottomOf="@id/totalTracksTime"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:id="@+id/playlists_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:behavior_hideable="false"
        app:behavior_peekHeight="350dp"

        android:background="@drawable/playlist_tracks"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:background="@drawable/rounder" />
        <androidx.recyclerview.widget.RecyclerView
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:id="@+id/songItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            tools:listitem="@layout/song_cart" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/playlists_bottom_menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:behavior_hideable="true"
        android:clickable="true"
        android:focusable="true"
        app:behavior_peekHeight="350dp"
        android:background="@drawable/playlist_tracks"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:background="@drawable/rounder" />
        <androidx.recyclerview.widget.RecyclerView
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:id="@+id/playlist_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            tools:listitem="@layout/playlist_item_horisontal" />
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginTop="12dp"
            android:text="@string/share"
            android:layout_marginHorizontal="@dimen/main_margin_horizontal"
            android:id="@+id/share_button"
            style="@style/SettingsPlaylist"
            />
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:text="@string/edit"
            android:layout_marginHorizontal="@dimen/main_margin_horizontal"
            android:id="@+id/edit"
            style="@style/SettingsPlaylist"
            />
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:text="@string/delete_playlist"
            android:layout_marginHorizontal="@dimen/main_margin_horizontal"
            android:id="@+id/delete_playlist"
            style="@style/SettingsPlaylist"
            />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>