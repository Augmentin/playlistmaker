<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/settings_view"
    tools:context=".presentation.settings.SettingsActivity"
    >
    <com.google.android.material.appbar.MaterialToolbar
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@drawable/arrow_back"
        style="@style/ToolbarMainText"
        android:id="@+id/back_toolbar"
        app:title="@string/settings"
        />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_dark_theme"
        android:layout_marginTop="@dimen/margin_from_toolbar"
        android:layout_marginHorizontal="@dimen/main_margin_horizontal"
        android:checked="true"
        style="@style/SettingMenuItem"
        android:id="@+id/themeSwitcher"
        />

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_share_app"
        android:drawableEnd="@drawable/sharing"
        android:layout_marginHorizontal="@dimen/main_margin_horizontal"
        android:id="@+id/share_button"
        style="@style/SettingMenuItem"
        />
    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_support"
        android:drawableEnd="@drawable/support"
        android:layout_marginHorizontal="@dimen/main_margin_horizontal"
        android:id="@+id/support_button"
        style="@style/SettingMenuItem" />
    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/agreement_button"
        android:text="@string/settings_agreement"
        android:drawableEnd="@drawable/arrow_forward"
        android:layout_marginHorizontal="@dimen/main_margin_horizontal"
        style="@style/SettingMenuItem" />

</LinearLayout>