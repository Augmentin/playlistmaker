<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingBottom="@dimen/main_padding_bottom">

    <com.google.android.material.appbar.MaterialToolbar
        style="@style/ToolbarMainText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/title" />

    <Button
        android:id="@+id/search_btn"
        style="@style/MainButton.Search"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/main_margin_horizontal"
        android:layout_marginTop="@dimen/margin_from_toolbar"
        android:layout_weight="1"
        android:text="@string/search" />

    <Button
        android:id="@+id/media_btn"
        style="@style/MainButton.Media"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/main_margin_horizontal"
        android:layout_weight="1"
        android:text="@string/media" />

    <Button
        android:id="@+id/settings_btn"
        style="@style/MainButton.Settings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/main_margin_horizontal"
        android:layout_weight="1"
        android:text="@string/settings" />


</LinearLayout>